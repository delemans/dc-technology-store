# Copia este archivo como .env y complétalo. El .env NUNCA se sube a GitHub (está en .gitignore).

# --- Supabase ---
SUPABASE_URL=https://vyqcizwfmjlflncdwzve.supabase.co
# Para n8n (lee la cola y los métodos de pago). Supabase → Project Settings → API Keys → service_role / secret.
SUPABASE_SERVICE_ROLE_KEY=
# Para ejecutar archivos .sql (herramientas/configurar-supabase.js). La service_role NO puede ejecutar SQL.
# Crea un token personal en https://supabase.com/dashboard/account/tokens (empieza por sbp_). Bórralo al terminar.
SUPABASE_ACCESS_TOKEN=

# --- n8n (herramientas/configurar-n8n.js) ---
N8N_URL=http://localhost:5678
# n8n → Settings → n8n API → Create an API key
N8N_API_KEY=

# --- Evolution API ---
EVOLUTION_URL=
EVOLUTION_INSTANCIA=
EVOLUTION_API_KEY=

# --- SiliconFlow (modelo deepseek-ai/DeepSeek-V3) ---
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# --- Opcional: tu WhatsApp personal para avisos de comprobantes y escalamientos (ej. 573001234567) ---
NUMERO_AVISO_ADMIN=
