
# Respaldos de flujos de n8n (pueden contener IDs de credenciales)
n8n/respaldos/

# Secretos locales: nunca al repositorio
.env
herramientas/.n8n-credenciales.json

# Dependencias de compilación (se instalan con npm install)
node_modules/

# Videos de estados (pesados: se comparten por WhatsApp, no se publican en el sitio)
docs/videos-estados/mp4/

# Salidas de herramientas (catálogo del proveedor, comparaciones): se regeneran
herramientas/salida/

# Muestra de la página del proveedor para pruebas (solo local: no se publica)
pruebas/flujo/anc/

# Material privado del director (lista de pendientes para el agente): solo en este PC
privado/
